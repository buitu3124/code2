{
  "name": "taiwan-bus-tracker-avatar",
  "private": true,
  "description": "3D signing avatar shown in the sign-language assistant (bundled into assets/avatar).",
  "scripts": {
    "build": "esbuild src/avatar.js --bundle --format=iife --minify --target=es2019 --outfile=../../assets/avatar/avatar.js && node -e \"require('fs').copyFileSync('src/index.html','../../assets/avatar/index.html')\"",
    "serve": "python -m http.server 8765 --directory ../../assets/avatar --bind 127.0.0.1"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.1.3",
    "three": "0.169.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "puppeteer-core": "23.6.0"
  }
}
